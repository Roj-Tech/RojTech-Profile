# Required for Courses admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Optional alternative to ADMIN_PASSWORD (sha256 hex of the password):
# ADMIN_PASSWORD_SHA256=

# Required in production (32+ characters). Used to sign admin session cookies.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional PDF upload limit in bytes (default 15728640 = 15MB)
MAX_UPLOAD_BYTES=15728640

# Optional Google Safe Browsing API key for Phishing Detector reputation checks
# Local URL heuristics work without this key.
GOOGLE_SAFE_BROWSING_API_KEY=
